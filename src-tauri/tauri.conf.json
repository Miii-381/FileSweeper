{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileSweeper",
  "version": "1.3.1",
  "identifier": "com.ayanami.filesweeper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileSweeper",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 650,
        "dragDropEnabled": true,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: filesweeper-background: http://filesweeper-background.localhost; media-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": [
      "../LICENSES"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
