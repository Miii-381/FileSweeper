# JavaScript dependencies, build output and test artifacts
/node_modules/
/dist/
/.npm-cache/
/coverage/
*.log

# Local environment, editor and agent state
/.npmrc
.env
.env.*
!.env.example
/.vscode/
/.idea/
/.agents/

# Operating-system and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak
*.swp
*~
*baiduyun.uploading.cfg*

# User-provided media tools and their downloaded archives are never project source
# or release inputs.
/sidecars/*
!/sidecars/sidecars说明.md
/ffmpeg-*/
/ffmpeg*.zip
/ffmpeg*.7z
/ffmpeg*.tar.*
/ffmpeg*.exe
/ffprobe*.exe
/ffmpegthumbnailer*.exe

# Rust and Tauri generated output
/src-tauri/target/
/src-tauri/gen/

# Windows NSIS builds only use icon.ico; generated Android/iOS and store icons are not source assets.
/icon.png
/src-tauri/icons/android/
/src-tauri/icons/ios/
/src-tauri/icons/*.png
/src-tauri/icons/icon.icns

# Runtime data
/data/

# Local development notes and working drafts are intentionally not versioned.
/开发文档/
