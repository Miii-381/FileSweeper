node_modules/
dist/
.npm-cache/
.agents/
*.log
.npmrc
icon.png

# User-provided media tools and their downloaded archives are never project source
# or release inputs. Keep only sidecars/README.md under version control.
/sidecars/*
!/sidecars/README.md
/ffmpeg-*/
/ffmpeg*.zip
/ffmpeg*.7z
/ffmpeg*.tar.*
/ffmpeg*.exe
/ffprobe*.exe
/ffmpegthumbnailer*.exe

src-tauri/target/
src-tauri/gen/

# Windows NSIS builds only use icon.ico; generated Android/iOS and store icons are not source assets.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/*.png
src-tauri/icons/icon.icns

data/

.agents
